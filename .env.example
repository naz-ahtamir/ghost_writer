# GhostWriter AI - Environment Configuration
# Pilihan AI_PROVIDER: openrouter | grok | gemini
AI_PROVIDER=openrouter

# OpenRouter (Untuk nousresearch/hermes-4-405b & model minim sensor lainnya): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nousresearch/hermes-4-405b

# Google Gemini (Gratis): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

NOVEL_DEFAULT_LANGUAGE=Indonesian
